<style>
    .wrapper {
        display: flex;
        flex-direction: column;
        min-height: 100vh;
    }

    .body {
        flex: 1;
        display: flex;
        flex-direction: column;
        align-items: center;

    }

    .chat-body {
        flex-grow: 1;
        display: flex;
        flex-direction: column;
        padding: 15px;
    }

    .container-lg {
        display: flex;
        flex-direction: column;
        flex-grow: 1;
    }

    .col-md-8,
    .card {
        display: flex;
        flex-direction: column;
        height: 100%;
    }

    .chat-container {
        flex-grow: 1;
        /* Stretch to fill available height */
        display: flex;
        flex-direction: column;
        border: 1px solid #ddd;
        border-radius: 5px;
        overflow: hidden;
        background-color: #fff;

    }

    .chat-history {
        flex-grow: 1;
        overflow-y: auto;
        max-height: 400px;
        min-height: 400px;
        padding: 10px;
        display: flex;
        flex-direction: column;
        justify-content: flex-start;

    }

    .chat-input {
        display: flex;
        padding: 10px;
        border-top: 1px solid #ddd;
        background-color: #f8f9fa;
        margin-bottom: 0%;
        padding-bottom: 0%;
    }

    .chat-input input {
        flex: 1;
        padding: 10px;
        border: 1px solid #ccc;
        border-radius: 7px;
    }

    .chat-input button {
        padding: 10px 20px;
        background-color: #007bff;
        color: white;
        border: none;
        border-radius: 7px;
        margin-left: 5px;
    }

    #chat-header {
        display: flex;
        align-items: center;
        /* Vertically align items within the header */
        padding: 10px;
        /* Add consistent padding */
    }

    #chat-header .avatar img {
        width: 40px;
        height: 40px;
        border-radius: 50%;
        /* Make sure the image is circular */
    }

    #chat-header h5 {
        margin: 0;
        color: white;
        font-weight: bold;
    }

    .message-bubble {
        max-width: 60%;
        padding-top: 15px;  
        padding-bottom: 15px;
        padding-left: 20px;
        padding-right: 20px;
        margin: 5px;
        border-radius: 15px;
        word-wrap: break-word;
    }

    .outgoing {
        background-color: #d4c2f0;
        color: #2e0849;
        text-align: right;
        margin-right: 0%;
        border-radius: 15px 15px 0 15px;
    }

    .incoming {
        background-color: #e2effc;
        color: #082349;
        text-align: left;
        margin-left: 0%;
        border-radius: 15px 15px 15px 0;
    } 

    .contact-item {
        transition: background-color 0.3s ease;
        cursor: pointer;
        color: rgb(0, 17, 70);
    }

    .contact-item:hover {
        background-color: #ebf0f4;
        /* Light gray background on hover */
    }

    form {
        display: flex;
        align-items: center;
        gap: 10px;
        width: 100%;
    }

    form input[type="text"] {
        flex-grow: 1;
        /* Ensures the input takes up available space */
    }

    form button {
        white-space: nowrap;
    }
</style>

<html lang="en">

<head>
    <base href="./">
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, shrink-to-fit=no">
    <meta name="description" content="CoreUI - Open Source Bootstrap Admin Template">
    <meta name="author" content="Łukasz Holeczek">
    <meta name="keyword" content="Bootstrap,Admin,Template,Open,Source,jQuery,CSS,HTML,RWD,Dashboard">
    <title>Language Exchange Project</title>
    <link rel="apple-touch-icon" sizes="57x57" href="/static/assets/favicon/apple-icon-57x57.png">
    <link rel="apple-touch-icon" sizes="60x60" href="/static/assets/favicon/apple-icon-60x60.png">
    <link rel="apple-touch-icon" sizes="72x72" href="/static/assets/favicon/apple-icon-72x72.png">
    <link rel="apple-touch-icon" sizes="76x76" href="/static/assets/favicon/apple-icon-76x76.png">
    <link rel="apple-touch-icon" sizes="114x114" href="/static/assets/favicon/apple-icon-114x114.png">
    <link rel="apple-touch-icon" sizes="120x120" href="/static/assets/favicon/apple-icon-120x120.png">
    <link rel="apple-touch-icon" sizes="144x144" href="/static/assets/favicon/apple-icon-144x144.png">
    <link rel="apple-touch-icon" sizes="152x152" href="/static/assets/favicon/apple-icon-152x152.png">
    <link rel="apple-touch-icon" sizes="180x180" href="/static/assets/favicon/apple-icon-180x180.png">
    <link rel="icon" type="image/png" sizes="192x192" href="/static/assets/favicon/android-icon-192x192.png">
    <link rel="icon" type="image/png" sizes="32x32" href="/static/assets/favicon/favicon-32x32.png">
    <link rel="icon" type="image/png" sizes="96x96" href="/static/assets/favicon/favicon-96x96.png">
    <link rel="icon" type="image/png" sizes="16x16" href="/static/assets/favicon/favicon-16x16.png">
    <link rel="manifest" href="/static/assets/favicon/manifest.json">
    <meta name="msapplication-TileColor" content="#ffffff">
    <meta name="msapplication-TileImage" content="/static/assets/favicon/ms-icon-144x144.png">
    <meta name="theme-color" content="#ffffff">
    <!-- /static/Vendors styles-->
    <link rel="stylesheet" href="/static//static/vendors/simplebar/css/simplebar.css">
    <link rel="stylesheet" href="/static/css//static/vendors/simplebar.css">
    <!-- Main styles for this application-->
    <link href="/static/css/style.css" rel="stylesheet">
</head>

<body>
    <div class="sidebar sidebar-dark sidebar-fixed" id="sidebar">
        <div class="sidebar-brand d-none d-md-flex">
            <svg class="sidebar-brand-full" width="118" height="46" alt="CoreUI Logo">
                <use xlink:href="/static/vendors/@coreui/icons/svg/free.svg#cil-group"></use>
            </svg> <strong>Language Exchange Project</strong>
        </div>
        <ul class="sidebar-nav" data-coreui="navigation" data-simplebar="">
            <li class="nav-item">
                <a class="nav-link" href="/user">
                    <svg class="nav-icon">
                        <use xlink:href="/static/vendors/@coreui/icons/svg/free.svg#cil-user"></use>
                    </svg> Profile
                </a>
            </li>
            <li class="nav-item">
                <a class="nav-link" href="/contact">
                    <svg class="nav-icon">
                        <use xlink:href="/static/vendors/@coreui/icons/svg/free.svg#cil-address-book"></use>
                    </svg> Contacts
                </a>
            </li>
            <li class="nav-item">
                <a class="nav-link" href="/message">
                    <svg class="nav-icon">
                        <use xlink:href="/static/vendors/@coreui/icons/svg/free.svg#cil-envelope-open"></use>
                    </svg> Messages
                </a>
            </li>
        </ul>
        <button class="sidebar-toggler" type="button" data-coreui-toggle="unfoldable"></button>
    </div>
    <div class="wrapper d-flex flex-column min-vh-100 bg-light">
        <header class="header header-sticky mb-4">
            <div class="container-fluid">
                <button class="header-toggler px-md-0 me-md-3" type="button"
                    onclick="coreui.Sidebar.getInstance(document.querySelector('#sidebar')).toggle()">
                    <svg class="icon icon-lg">
                        <use xlink:href="/static/vendors/@coreui/icons/svg/free.svg#cil-menu"></use>
                    </svg>
                </button>
                <a class="header-brand d-md-none" href="#">
                    <svg width="118" height="46" alt="CoreUI Logo">
                        <use xlink:href="/static/vendors/@coreui/icons/svg/free.svg#cil-group"></use>
                    </svg>
                </a>
                <ul class="header-nav d-none d-md-flex">
                    <li class="nav-item"><a class="nav-link" href="/user">Profile</a></li>
                </ul>
                <ul class="header-nav d-none d-md-flex">
                    <li class="nav-item"><a class="nav-link" href="/contact">Contacts</a></li>
                </ul>
                <ul class="header-nav d-none d-md-flex">
                    <li class="nav-item"><a class="nav-link" href="/message">Messages</a></li>
                </ul>

                <ul class="header-nav ms-auto">
                    <li class="nav-item">
                        <a class="nav-link" href="/user"> <!-- Add link to profile page -->
                            <svg class="icon icon-lg">
                                <use xlink:href="/static/vendors/@coreui/icons/svg/free.svg#cil-user"></use>
                            </svg></a>
                    </li>
                    <li class="nav-item"><a class="nav-link" href="/contact"> <!-- Add link to contact page -->
                            <svg class="icon icon-lg">
                                <use xlink:href="/static/vendors/@coreui/icons/svg/free.svg#cil-address-book"></use>
                            </svg></a></li>
                    <li class="nav-item"><a class="nav-link" href="/message"> <!-- Add link to messages page -->
                            <svg class="icon icon-lg">
                                <use xlink:href="/static/vendors/@coreui/icons/svg/free.svg#cil-envelope-open"></use>
                            </svg></a></li>
                </ul>

                <ul class="header-nav ms-3">
                    <li class="nav-item dropdown">
                        <a class="nav-link py-0" data-coreui-toggle="dropdown" href="#" role="button"
                            aria-haspopup="true" aria-expanded="false">
                            <div class="avatar avatar-md"><img class="avatar-img" src="{{profilePhotoPath}}"
                                    alt="user@email.com"></div>
                        </a>
                        <div class="dropdown-menu dropdown-menu-end pt-0">
                            <a class="dropdown-item" href="/user"> <!-- Add link to profile page -->
                                <svg class="icon me-2">
                                    <use xlink:href="/static/vendors/@coreui/icons/svg/free.svg#cil-user"></use>
                                </svg> Profile
                            </a>
                            <a class="dropdown-item" href="/contact"> <!-- Add link to contact page -->
                                <svg class="icon me-2">
                                    <use xlink:href="/static/vendors/@coreui/icons/svg/free.svg#cil-address-book"></use>
                                </svg> Contacts</a>
                            <a class="dropdown-item" href="/message"> <!-- Add link to messages page -->
                                <svg class="icon me-2">
                                    <use xlink:href="/static/vendors/@coreui/icons/svg/free.svg#cil-envelope-open">
                                    </use>
                                </svg> Messages
                            </a>
                            <div class="dropdown-divider"></div>
                            <a class="dropdown-item" href="/logout">
                                <svg class="icon me-2">
                                    <use xlink:href="/static/vendors/@coreui/icons/svg/free.svg#cil-account-logout">
                                    </use>
                                </svg> Logout
                            </a>
                        </div>
                    </li>
                </ul>
            </div>
            <!-- CoreUI and necessary plugins-->
            <script src="/static/vendors/@coreui/coreui/js/coreui.bundle.min.js"></script>
            <script src="/static/vendors/simplebar/js/simplebar.min.js"></script>
        </header>

        <!-- Messaging Section -->
        <div class="body flex-grow-1 d-flex flex-column px-3">
            <div class="container-lg flex-grow-1 d-flex">
                <div class="row flex-grow-1 w-100">
                    <!-- Contact List -->
                    <div class="col-md-4">
                        <div class="card ">
                            <div class="card-header bg-primary text-white">
                                <h5>Contacts</h5>
                            </div>
                            <ul class="list-group list-group-flush contact-list">
                                {{#each contacts}}
                                <a href="/message/{{this.username}}" class="text-decoration-none">
                                    <div class="contact-item d-flex align-items-center p-3 border-bottom">
                                        <div class="avatar me-3">
                                            <img src="{{profilePhotoPath}}" alt="{{username}}" class="rounded-circle"
                                                width="40" height="40">
                                        </div>
                                        <div>
                                            <h5 class="mb-0">{{username}}</h5>
                                        </div>
                                    </div>
                                </a>
                                {{/each}}
                            </ul>
                        </div>
                    </div>

                    <!-- Chat Section -->
                    <div class="col-md-8 d-flex flex-column">
                        <div class="card h-100 d-flex flex-column">
                            {{#if contactUsername}}
                            <!-- Chat Section -->
                            <div class="d-flex flex-column flex-grow-1">
                                <!-- Chat Header -->
                                <div class="card-header bg-primary text-white d-flex align-items-center">
                                    <h5 class="mb-0">Your chat with {{contactUsername}}</h5>
                                </div>

                                <!-- Chat History -->
                                <div class="card-body chat-history flex-grow-1">
                                    {{#each messages}}
                                    <div
                                        class="d-flex {{#if (eq this.sender ../loggedInUsername)}}justify-content-end{{else}}justify-content-start{{/if}}">
                                        <div
                                            class="message-bubble {{#if (eq this.sender ../loggedInUsername)}}outgoing{{else}}incoming{{/if}} p-2 mb-2 rounded">
                                            <div><strong>{{this.sender}}</strong></div>
                                            <div>{{this.message}}</div>
                                            <small style=" color:#59595c">Sent: {{this.time}}</small>
                                        </div>
                                    </div>
                                    {{/each}}
                                </div>

                                <!-- Chat Input -->
                                <div class="card-footer chat-input d-flex align-items-center">
                                    <form method="post" , action="/message/{{contactUsername}}">
                                        <input type="text" class="form-control me-2" id="message-input" name="message"
                                            placeholder="Type a message...">
                                        <button class="btn btn-primary" id="send-button" type="submit">Send</button>
                                        <input type="hidden" name="contactUsername" value="{{contactUsername}}">
                                        <input type="hidden" name="csrfToken" value="{{csrfToken}}">
                                    </form>
                                </div>
                            </div>
                            {{else}}
                            <div class="card-header bg-primary text-white">
                                <h5>Select a contact to start chatting</h5>
                            </div>
                            <div class="card-body d-flex align-items-center justify-content-center">
                                <p>Start a new conversation, or continue an existing one!</p>
                            </div>
                            {{/if}}
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <footer class="footer">
            <div>
                Language Exchange Project by Tehreem Masroor and Manahil Sheikh @ 2024
            </div>
            <div class="ms-auto">Powered by&nbsp;<a href="https://coreui.io/docs/">CoreUI UI Components</a></div>
        </footer>
    </div>
    <!-- CoreUI and necessary plugins-->
    <script src="/static/vendors/@coreui/coreui/js/coreui.bundle.min.js"></script>
    <script src="/static/vendors/simplebar/js/simplebar.min.js"></script>
    <script>
    </script>
</body>

</html>