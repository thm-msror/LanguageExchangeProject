<!DOCTYPE html>
<html lang="en">

<head>
  <title>Email Verification - Language Exchange</title>
  <link href="/static/css/style.css" rel="stylesheet"> <!-- assuming you use coreui css -->
</head>

<body>
  <div class="bg-light min-vh-100 d-flex flex-row align-items-center">
    <div class="container">
      <div class="row justify-content-center">
        <div class="col-md-6">
          <div class="clearfix text-center">
            <h1 class="display-4">Email Verification</h1>
            <h4 class="pt-3">Almost there!</h4>
            <p class="text-medium-emphasis">Click the link below to verify your account.</p>
            <div class="mt-4">
              <a href="{{verificationLink}}" class="btn btn-primary">Verify Now</a>
            </div>
            <p class="mt-3">Already verified? <a href="/">Go to Home</a></p>
          </div>
        </div>
      </div>
    </div>
  </div>
</body>

</html>
