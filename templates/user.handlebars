<html lang="en">

<body>
    <div class="sidebar sidebar-dark sidebar-fixed" id="sidebar">
        <div class="sidebar-brand d-none d-md-flex">
            <svg class="sidebar-brand-full" width="118" height="46" alt="CoreUI Logo">
                <use xlink:href="static/vendors/@coreui/icons/svg/free.svg#cil-group"></use>
            </svg> <strong>Language Exchange Project</strong>
        </div>
        <ul class="sidebar-nav" data-coreui="navigation" data-simplebar="">
            <li class="nav-item">
                <a class="nav-link" href="/user"> <!-- Add link to profile page -->
                    <svg class="nav-icon">
                        <use xlink:href="static/vendors/@coreui/icons/svg/free.svg#cil-user"></use>
                    </svg> Profile
                </a>
            </li>
            <li class="nav-item">
                <a class="nav-link" href="/contact"> <!-- Add link to contact page -->
                    <svg class="nav-icon">
                        <use xlink:href="static/vendors/@coreui/icons/svg/free.svg#cil-address-book"></use>
                    </svg> Contacts
                </a>
            </li>
            <li class="nav-item">
                <a class="nav-link" href="/message"> <!-- Add link to messages page -->
                    <svg class="nav-icon">
                        <use xlink:href="static/vendors/@coreui/icons/svg/free.svg#cil-envelope-open"></use>
                    </svg> Messages
                </a>
            </li>
            <li class="nav-item">
                <a class="nav-link" href="/badge"> <!-- Add link to messages page -->
                    <svg class="nav-icon">
                        <use xlink:href="static/vendors/@coreui/icons/svg/free.svg#cil-badge"></use>
                    </svg> Badges
                </a>
            </li>
        </ul>
        <button class="sidebar-toggler" type="button" data-coreui-toggle="unfoldable"></button>
    </div>
    <div class="wrapper d-flex flex-column min-vh-100 bg-light">
        <header class="header header-sticky mb-4">
            <div class="container-fluid">
                <button class="header-toggler px-md-0 me-md-3" type="button"
                    onclick="coreui.Sidebar.getInstance(document.querySelector('#sidebar')).toggle()">
                    <svg class="icon icon-lg">
                        <use xlink:href="static/vendors/@coreui/icons/svg/free.svg#cil-menu"></use>
                    </svg>
                </button>
                <a class="header-brand d-md-none" href="#">
                    <svg width="118" height="46" alt="CoreUI Logo">
                        <use xlink:href="static/assets/brand/coreui.svg#full"></use>
                    </svg>
                </a>
                <ul class="header-nav d-none d-md-flex">
                    <li class="nav-item"><a class="nav-link" href="/user">Profile</a></li>
                </ul>
                <ul class="header-nav d-none d-md-flex">
                    <li class="nav-item"><a class="nav-link" href="/contact">Contacts</a></li>
                </ul>
                <ul class="header-nav d-none d-md-flex">
                    <li class="nav-item"><a class="nav-link" href="/message">Messages</a></li>
                </ul>
                <ul class="header-nav d-none d-md-flex">
                    <li class="nav-item"><a class="nav-link" href="/badge">Badges</a></li>
                </ul>

                <ul class="header-nav ms-auto">
                    <li class="nav-item"><a class="nav-link" href="/user"> <!-- Add link to profile page -->
                            <svg class="icon icon-lg">
                                <use xlink:href="static/vendors/@coreui/icons/svg/free.svg#cil-user"></use>
                            </svg></a></li>
                    <li class="nav-item"><a class="nav-link" href="/contact"> <!-- Add link to contact page -->
                            <svg class="icon icon-lg">
                                <use xlink:href="static/vendors/@coreui/icons/svg/free.svg#cil-address-book"></use>
                            </svg></a></li>
                    <li class="nav-item"><a class="nav-link" href="/message"> <!-- Add link to messages page -->
                            <svg class="icon icon-lg">
                                <use xlink:href="static/vendors/@coreui/icons/svg/free.svg#cil-envelope-open"></use>
                            </svg></a></li>
                    <li class="nav-item"><a class="nav-link" href="/badge"> <!-- Add link to badges page -->
                            <svg class="icon icon-lg">
                                <use xlink:href="static/vendors/@coreui/icons/svg/free.svg#cil-badge"></use>
                            </svg></a></li>
                </ul>

                <ul class="header-nav ms-3">
                    <li class="nav-item dropdown">
                        <a class="nav-link py-0" data-coreui-toggle="dropdown" href="#" role="button"
                            aria-haspopup="true" aria-expanded="false">
                            <div class="avatar avatar-md"><img class="avatar-img" src="{{profilePhotoPath}}"
                                    alt="user@email.com"></div>
                        </a>
                        <div class="dropdown-menu dropdown-menu-end pt-0">
                            <a class="dropdown-item" href="/user"> <!-- Add link to profile page -->
                                <svg class="icon me-2">
                                    <use xlink:href="static/vendors/@coreui/icons/svg/free.svg#cil-user"></use>
                                </svg> Profile
                            </a>
                            <a class="dropdown-item" href="/contact"> <!-- Add link to contact page -->
                                <svg class="icon me-2">
                                    <use xlink:href="static/vendors/@coreui/icons/svg/free.svg#cil-address-book"></use>
                                </svg> Contacts</a>
                            <a class="dropdown-item" href="/message"> <!-- Add link to messages page -->
                                <svg class="icon me-2">
                                    <use xlink:href="static/vendors/@coreui/icons/svg/free.svg#cil-envelope-open"></use>
                                </svg> Messages
                            </a>
                            <a class="dropdown-item" href="/badge"> <!-- Add link to badges page -->
                                <svg class="icon me-2">
                                    <use xlink:href="static/vendors/@coreui/icons/svg/free.svg#cil-badge"></use>
                                </svg> Badges
                            </a>
                            <div class="dropdown-divider"></div>
                            <a class="dropdown-item" href="/logout">
                                <svg class="icon me-2">
                                    <use xlink:href="static/vendors/@coreui/icons/svg/free.svg#cil-account-logout">
                                    </use>
                                </svg> Logout
                            </a>
                        </div>
                    </li>
                </ul>
            </div>
            <div class="header-divider"></div>
            <div class="container-fluid">
                <nav aria-label="breadcrumb">
                    <ol class="breadcrumb my-0 ms-2">
                        <li class="breadcrumb-item">
                            <a href="/user">Profile</a>
                        </li>
                    </ol>
                </nav>
            </div>
        </header>

        <!-- Profile Form -->
        <div class="bg-light min-vh-100 d-flex flex-row align-items-center">
            <div class="container">
                <div class="row justify-content-center">
                    <div class="col-md-10">
                        <div class="card mb-4 mx-4">
                            <div class="card-body p-4">
                                <h1>Welcome back, {{username}}!</h1>
                                <br>
                                {{#if description}}
                                <!-- Display Profile Information -->
                                <h2>Your Profile</h2>
                                <p><strong>Description:</strong> {{description}}</p>
                                <p><strong>Fluent Languages:</strong> <br>{{#each fluentLang}}{{this}}<br> {{/each}}</p>
                                <p><strong>Desired Languages:</strong> <br>{{#each learnLang}}{{this}}<br> {{/each}}</p>
                                {{#if profilePhotoPath}}
                                <img src="{{profilePhotoPath}}" alt="Profile Photo" class="img-thumbnail"
                                    style="max-width: 150px;">
                                {{/if}}
                                {{else}}


                                <!-- Profile Form -->
                                <form action="/user" method="POST" enctype="multipart/form-data">

                                    <input type="hidden" name="csrfToken" value="{{csrfToken}}">

                                    <div class="mb-3">
                                        <label for="description" class="form-label">Describe yourself:</label>
                                        <textarea name="description" id="description" rows="4" placeholder="Optional"
                                            class="form-control"></textarea>
                                    </div>

                                    <div class="mb-3">
                                        <label class="form-label">Fluent Languages:</label>
                                        <div class="form-check">
                                            <input type="checkbox" name="fluentLang[]" value="English"
                                                id="fluentEnglish" class="form-check-input">
                                            <label for="fluentEnglish" class="form-check-label">English</label>
                                        </div>
                                        <div class="form-check">
                                            <input type="checkbox" name="fluentLang[]" value="Spanish"
                                                id="fluentSpanish" class="form-check-input">
                                            <label for="fluentSpanish" class="form-check-label">Spanish</label>
                                        </div>
                                        <div class="form-check">
                                            <input type="checkbox" name="fluentLang[]" value="French" id="fluentFrench"
                                                class="form-check-input">
                                            <label for="fluentFrench" class="form-check-label">French</label>
                                        </div>
                                        <div class="form-check">
                                            <input type="checkbox" name="fluentLang[]" value="German" id="fluentGerman"
                                                class="form-check-input">
                                            <label for="fluentGerman" class="form-check-label">German</label>
                                        </div>
                                        <div class="form-check">
                                            <input type="checkbox" name="fluentLang[]" value="Chinese"
                                                id="fluentChinese" class="form-check-input">
                                            <label for="fluentChinese" class="form-check-label">Chinese</label>
                                        </div>
                                        <div class="form-check">
                                            <input type="checkbox" name="fluentLang[]" value="Arabic" id="fluentArabic"
                                                class="form-check-input">
                                            <label for="fluentArabic" class="form-check-label">Arabic</label>
                                        </div>
                                        <div class="form-check">
                                            <input type="checkbox" name="fluentLang[]" value="Urdu" id="fluentUrdu"
                                                class="form-check-input">
                                            <label for="fluentUrdu" class="form-check-label">Urdu</label>
                                        </div>
                                        <div class="form-check">
                                            <input type="checkbox" name="fluentLang[]" value="Hindi" id="fluentHindi"
                                                class="form-check-input">
                                            <label for="fluentHindi" class="form-check-label">Hindi</label>
                                        </div>
                                    </div>
                                    {{#if error}}
                                    <div class="alert alert-danger">{{error}}</div>
                                    {{/if}}

                                    <div class="mb-3">
                                        <label class="form-label">Desired Languages:</label>
                                        <div class="form-check">
                                            <input type="checkbox" name="learnLang[]" value="English" id="learnEnglish"
                                                class="form-check-input">
                                            <label for="learnEnglish" class="form-check-label">English</label>
                                        </div>
                                        <div class="form-check">
                                            <input type="checkbox" name="learnLang[]" value="Spanish" id="learnSpanish"
                                                class="form-check-input">
                                            <label for="learnSpanish" class="form-check-label">Spanish</label>
                                        </div>
                                        <div class="form-check">
                                            <input type="checkbox" name="learnLang[]" value="French" id="learnFrench"
                                                class="form-check-input">
                                            <label for="learnFrench" class="form-check-label">French</label>
                                        </div>
                                        <div class="form-check">
                                            <input type="checkbox" name="learnLang[]" value="German" id="learnGerman"
                                                class="form-check-input">
                                            <label for="learnGerman" class="form-check-label">German</label>
                                        </div>
                                        <div class="form-check">
                                            <input type="checkbox" name="learnLang[]" value="Chinese" id="learnChinese"
                                                class="form-check-input">
                                            <label for="learnChinese" class="form-check-label">Chinese</label>
                                        </div>
                                        <div class="form-check">
                                            <input type="checkbox" name="learnLang[]" value="Arabic" id="learnArabic"
                                                class="form-check-input">
                                            <label for="learnArabic" class="form-check-label">Arabic</label>
                                        </div>
                                        <div class="form-check">
                                            <input type="checkbox" name="learnLang[]" value="Urdu" id="learnUrdu"
                                                class="form-check-input">
                                            <label for="learnUrdu" class="form-check-label">Urdu</label>
                                        </div>
                                        <div class="form-check">
                                            <input type="checkbox" name="learnLang[]" value="Hindi" id="learnHindi"
                                                class="form-check-input">
                                            <label for="learnHindi" class="form-check-label">Hindi</label>
                                        </div>
                                    </div>
                                    {{#if error}}
                                    <div class="alert alert-danger">{{error}}</div>
                                    {{/if}}

                                    <div class="mb-3">
                                        <label for="profilePhoto" class="form-label">Upload Profile Photo:</label>
                                        <input type="file" name="profilePhoto" id="profilePhoto" class="form-control">
                                    </div>

                                    <button type="submit" class="btn btn-primary">Submit Profile</button>
                                </form>
                                {{/if}}
                            </div>

                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="body flex-grow-1 px-3">
            <div class="container-lg">
            </div>
        </div>

        <footer class="footer">
            <div><a href="https://coreui.io">CoreUI </a><a href="https://coreui.io">Bootstrap Admin Template</a> © 2023
                creativeLabs.</div>
            <div class="ms-auto">Powered by&nbsp;<a href="https://coreui.io/docs/">CoreUI UI Components</a></div>
        </footer>
    </div>
</body>

</html>