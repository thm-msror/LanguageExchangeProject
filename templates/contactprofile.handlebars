<html lang="en">

<head>
    <base href="./">
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, shrink-to-fit=no">
    <meta name="description" content="CoreUI - Open Source Bootstrap Admin Template">
    <meta name="author" content="Łukasz Holeczek">
    <meta name="keyword" content="Bootstrap,Admin,Template,Open,Source,jQuery,CSS,HTML,RWD,Dashboard">
    <title>Language Exchange Project</title>
    <link rel="apple-touch-icon" sizes="57x57" href="/static/assets/favicon/apple-icon-57x57.png">
    <link rel="apple-touch-icon" sizes="60x60" href="/static/assets/favicon/apple-icon-60x60.png">
    <link rel="apple-touch-icon" sizes="72x72" href="/static/assets/favicon/apple-icon-72x72.png">
    <link rel="apple-touch-icon" sizes="76x76" href="/static/assets/favicon/apple-icon-76x76.png">
    <link rel="apple-touch-icon" sizes="114x114" href="/static/assets/favicon/apple-icon-114x114.png">
    <link rel="apple-touch-icon" sizes="120x120" href="/static/assets/favicon/apple-icon-120x120.png">
    <link rel="apple-touch-icon" sizes="144x144" href="/static/assets/favicon/apple-icon-144x144.png">
    <link rel="apple-touch-icon" sizes="152x152" href="/static/assets/favicon/apple-icon-152x152.png">
    <link rel="apple-touch-icon" sizes="180x180" href="/static/assets/favicon/apple-icon-180x180.png">
    <link rel="icon" type="image/png" sizes="192x192" href="/static/assets/favicon/android-icon-192x192.png">
    <link rel="icon" type="image/png" sizes="32x32" href="/static/assets/favicon/favicon-32x32.png">
    <link rel="icon" type="image/png" sizes="96x96" href="/static/assets/favicon/favicon-96x96.png">
    <link rel="icon" type="image/png" sizes="16x16" href="/static/assets/favicon/favicon-16x16.png">
    <link rel="manifest" href="/static/assets/favicon/manifest.json">
    <meta name="msapplication-TileColor" content="#ffffff">
    <meta name="msapplication-TileImage" content="/static/assets/favicon/ms-icon-144x144.png">
    <meta name="theme-color" content="#ffffff">
    <!-- /static/Vendors styles-->
    <link rel="stylesheet" href="/static//static/vendors/simplebar/css/simplebar.css">
    <link rel="stylesheet" href="/static/css//static/vendors/simplebar.css">
    <!-- Main styles for this application-->
    <link href="/static/css/style.css" rel="stylesheet">

    <style>
        .profile-header {
            display: flex;
            align-items: center;
            margin-bottom: 1rem;
        }

        .profile-header img {
            border-radius: 50%;
            width: 150px;
            height: 150px;
            margin-right: 1rem;
        }

        .profile-header h1 {
            margin: 0;
        }

        .description {
            margin-bottom: 1rem;
            border: 1px solid #e2e2e2;
            border-radius: 5px;
            padding: 1rem;
        }

        .description p {
            font-size: 1.2rem;
        }

        .grid-container {
            display: grid;
            grid-template-columns: 1fr 1fr;
            /* Two equal columns */
            gap: 1rem;
            /* Space between columns */
        }

        .left-column,
        .right-column {
            padding: 1rem;
            border: 1px solid #e2e2e2;
            /* Optional: Add a border for clarity */
            border-radius: 5px;
            /* Optional: Rounded corners */
        }

        .badges {
            display: flex;
            /* Use flexbox for layout */
            justify-content: space-between;
            /* Space out badges evenly */
        }

        .badge {
            display: flex;
            /* Use flexbox for each badge */
            flex-direction: column;
            /* Stack icon and description vertically */
            align-items: center;
            /* Center align items */
            width: 45%;
            /* Adjust width to fit two badges in a row */
        }

        .badge img {
            width: 80px;
            /* Adjust badge icon size */
            height: 85px;
            /* Adjust badge icon size */
            margin-bottom: 0.5rem;
            /* Space between icon and description */
        }

        .badge-description p {
            text-align: center;
            /* Center the description text */
            color: black;
            font-weight: normal;
            width: 45%;
        }

        .badge-description h6 {
            text-align: center;
            /* Center the description text */
            color: black;
            font-weight: normal;
        }
    </style>
</head>

<body>
    <div class="sidebar sidebar-dark sidebar-fixed" id="sidebar">
        <div class="sidebar-brand d-none d-md-flex">
            <svg class="sidebar-brand-full" width="118" height="46" alt="CoreUI Logo">
                <use xlink:href="/static/vendors/@coreui/icons/svg/free.svg#cil-group"></use>
            </svg> <strong>Language Exchange Project</strong>
        </div>
        <ul class="sidebar-nav" data-coreui="navigation" data-simplebar="">
            <li class="nav-item">
                <a class="nav-link" href="/user"> <!-- Add link to profile page -->
                    <svg class="nav-icon">
                        <use xlink:href="/static/vendors/@coreui/icons/svg/free.svg#cil-user"></use>
                    </svg> Profile
                </a>
            </li>
            <li class="nav-item">
                <a class="nav-link" href="/contact"> <!-- Add link to contact page -->
                    <svg class="nav-icon">
                        <use xlink:href="/static/vendors/@coreui/icons/svg/free.svg#cil-address-book"></use>
                    </svg> Contacts
                </a>
            </li>
            <li class="nav-item">
                <a class="nav-link" href="/message"> <!-- Add link to messages page -->
                    <svg class="nav-icon">
                        <use xlink:href="/static/vendors/@coreui/icons/svg/free.svg#cil-envelope-open"></use>
                    </svg> Messages
                </a>
            </li>
        </ul>
        <button class="sidebar-toggler" type="button" data-coreui-toggle="unfoldable"></button>
    </div>
    <div class="wrapper d-flex flex-column min-vh-100 bg-light">
        <header class="header header-sticky mb-4">
            <div class="container-fluid">
                <button class="header-toggler px-md-0 me-md-3" type="button"
                    onclick="coreui.Sidebar.getInstance(document.querySelector('#sidebar')).toggle()">
                    <svg class="icon icon-lg">
                        <use xlink:href="/static/vendors/@coreui/icons/svg/free.svg#cil-menu"></use>
                    </svg>
                </button>
                <a class="header-brand d-md-none" href="#">
                    <svg width="118" height="46" alt="CoreUI Logo">
                        <use xlink:href="/static/vendors/@coreui/icons/svg/free.svg#cil-group"></use>
                    </svg>
                </a>
                <ul class="header-nav d-none d-md-flex">
                    <li class="nav-item"><a class="nav-link" href="/user">Profile</a></li>
                </ul>
                <ul class="header-nav d-none d-md-flex">
                    <li class="nav-item"><a class="nav-link" href="/contact">Contacts</a></li>
                </ul>
                <ul class="header-nav d-none d-md-flex">
                    <li class="nav-item"><a class="nav-link" href="/message">Messages</a></li>
                </ul>

                <ul class="header-nav ms-auto">
                    <li class="nav-item"><a class="nav-link" href="/user"> <!-- Add link to profile page -->
                            <svg class="icon icon-lg">
                                <use xlink:href="/static/vendors/@coreui/icons/svg/free.svg#cil-user"></use>
                            </svg></a></li>
                    <li class="nav-item"><a class="nav-link" href="/contact"> <!-- Add link to contact page -->
                            <svg class="icon icon-lg">
                                <use xlink:href="/static/vendors/@coreui/icons/svg/free.svg#cil-address-book"></use>
                            </svg></a></li>
                    <li class="nav-item"><a class="nav-link" href="/message"> <!-- Add link to messages page -->
                            <svg class="icon icon-lg">
                                <use xlink:href="/static/vendors/@coreui/icons/svg/free.svg#cil-envelope-open"></use>
                            </svg></a></li>
                </ul>

                <ul class="header-nav ms-3">
                    <li class="nav-item dropdown">
                        <a class="nav-link py-0" data-coreui-toggle="dropdown" href="#" role="button"
                            aria-haspopup="true" aria-expanded="false">
                            <div class="avatar avatar-md"><img class="avatar-img" src="{{profilePhotoPath}}"
                                    alt="user@email.com"></div>
                        </a>
                        <div class="dropdown-menu dropdown-menu-end pt-0">
                            <a class="dropdown-item" href="/user"> <!-- Add link to profile page -->
                                <svg class="icon me-2">
                                    <use xlink:href="/static/vendors/@coreui/icons/svg/free.svg#cil-user"></use>
                                </svg> Profile
                            </a>
                            <a class="dropdown-item" href="/contact"> <!-- Add link to contact page -->
                                <svg class="icon me-2">
                                    <use xlink:href="/static/vendors/@coreui/icons/svg/free.svg#cil-address-book"></use>
                                </svg> Contacts</a>
                            <a class="dropdown-item" href="/message"> <!-- Add link to messages page -->
                                <svg class="icon me-2">
                                    <use xlink:href="/static/vendors/@coreui/icons/svg/free.svg#cil-envelope-open">
                                    </use>
                                </svg> Messages
                            </a>
                            <div class="dropdown-divider"></div>
                            <a class="dropdown-item" href="/logout">
                                <svg class="icon me-2">
                                    <use xlink:href="/static/vendors/@coreui/icons/svg/free.svg#cil-account-logout">
                                    </use>
                                </svg> Logout
                            </a>
                        </div>
                    </li>
                </ul>
            </div>
        </header>

        <!-- Main content -->
        <div class="bg-light min-vh-100 d-flex flex-row align-items-center">
            <div class="container">
                <div class="row justify-content-center">
                    <div class="col-md-10">
                        <div class="card mb-4 mx-4">
                            <div class="card-body p-4">
                                <!-- Display Contact's Profile  -->
                                <div class="profile-header">
                                    {{#if contactProfile.profilePhotoPath}}
                                    <img src="{{contactProfile.profilePhotoPath}}" alt="Profile Photo"
                                        class="img-thumbnail" style="max-width: 150px;">
                                    {{/if}}
                                    <h1>{{contactUsername}}'s Profile</h1>
                                </div>
                                <div class="description">
                                    <h3>Description</h3>
                                    <p>{{contactProfile.description}}</p>
                                </div>
                                <div class="grid-container">
                                    <div class="left-column">
                                        <h3>Languages</h3>
                                        <br>
                                        <h4>Fluent in</h4>
                                        <ul>
                                            {{#each contactProfile.fluentLang}}
                                            <li>{{this}}</li>
                                            {{/each}}
                                        </ul>
                                        <br>
                                        <h4>Learning</h4>
                                        <ul>
                                            {{#each contactProfile.learnLang}}
                                            <li>{{this}}</li>
                                            {{/each}}
                                        </ul>
                                    </div>
                                    <div class="right-column">
                                        <h3>Badges Earned</h3>
                                        <div class="badges">
                                            {{#each badges}}
                                            <div class="badge">
                                                <img src="{{this.photoPath}}" alt="{{this.title}}">
                                                <div class="badge-description">
                                                    <h6>{{this.title}}</h6>
                                                    <p>{{this.description}}</p>
                                                </div>
                                            </div>
                                            {{/each}}
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="body flex-grow-1 px-3">
            <div class="container-lg">
            </div>
        </div>

        <footer class="footer">
            <div><a href="https://coreui.io">CoreUI </a><a href="https://coreui.io">Bootstrap Admin Template</a> © 2023
                creativeLabs.</div>
            <div class="ms-auto">Powered by&nbsp;<a href="https://coreui.io/docs/">CoreUI UI Components</a></div>
        </footer>
    </div>

    <!-- CoreUI and necessary plugins-->
    <script src="/static/vendors/@coreui/coreui/js/coreui.bundle.min.js"></script>
    <script src="/static/vendors/simplebar/js/simplebar.min.js"></script>
    <script>
    </script>
</body>

</html>