        <script>
            async function fetchContacts() {
                try {
                    // Fetch suggested contacts
                    const suggestedResponse = await fetch('/api/contacts/suggested');
                    const suggestedContacts = await suggestedResponse.json();

                    // Fetch current contacts
                    const currentResponse = await fetch('/api/contacts/current');
                    const currentContacts = await currentResponse.json();

                    // Filter suggested contacts to exclude already added contacts
                    const filteredsuggestedContacts = suggestedContacts.filter(
                        suggestedContact => !currentContacts.some(contact => contact._id === suggestedContact._id)
                    );

                    // Render suggested Contacts
                    const suggestedContainer = document.getElementById('suggested-contacts');
                    suggestedContainer.innerHTML = filteredsuggestedContacts
                        .map(contact => `
                        <br>
                        <div class="d-flex align-items-center justify-content-center mb-3"> <!-- Flex container for alignment -->
                            <img src="${contact.profilePhotoPath}" alt="${contact.username}" class="avatar me-2"> 
                            <strong class="me-2">${contact.username}</strong> 
                            <button class="btn btn-success btn-sm ms-3" onclick="addContact('${contact.username}')">Add</button>
                            <button class="btn btn-danger btn-sm ms-3" onclick="blockContact('${contact.username}')">Block</button>
                        </div>
                        `).join('');

                    // Render Current Contacts
                    const contactContainer = document.getElementById('contact-list');
                    contactContainer.innerHTML = currentContacts
                        .map(contact => `
                            <br>    
                            <div class="d-flex align-items-center justify-content-center mb-3"> <!-- Flex container for alignment -->
                                <img src="${contact.profilePhotoPath}" alt="${contact.username}" class="avatar me-2"> 
                                <a href="/user/${contact.username}" class="me-2" style="color: inherit; text-decoration: none;"><strong>${contact.username}</strong></a>
                                <button class="btn btn-danger btn-sm ms-3" onclick="removeContact('${contact.username}')">Remove</button>
                                <button class="btn btn-danger btn-sm ms-3" onclick="blockContact('${contact.username}')">Block</button>
                                
                            </div>
                        `).join('');


                } catch (error) {
                    console.error('Error fetching contacts:', error);
                }
                
            }

            async function addContact(contactUsername) {
                try {
                    const response = await fetch('/api/contacts/add', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({ contactUsername }),
                    });


                    if (response.ok) {
                        // Re-fetch contacts to update the UI after adding
                        fetchContacts();
                    } else {
                        console.error('Failed to add contact:', await response.text());
                    }
                } catch (error) {
                    console.error('Error adding contact:', error);
                }
            }

            async function removeContact(contactUsername) {
                try {
                    const response = await fetch(`/api/contacts/remove/${contactUsername}`, { method: 'DELETE' });

                    if (response.ok) {
                        // Re-fetch contacts to update the UI after removing
                        fetchContacts();
                    } else {
                        console.error('Failed to remove contact:', await response.text());
                    }
                } catch (error) {
                    console.error('Error removing contact:', error);
                }
            }

            async function blockContact(contactUsername) {
                 try {
                    const response = await fetch(`/api/contacts/block/${contactUsername}`, { method: 'DELETE' });

                    if (response.ok) {
                        // Re-fetch contacts to update the UI after removing
                        fetchContacts();
                    } else {
                        console.error('Failed to block contact:', await response.text());
                    }
                } catch (error) {
                    console.error('Error blocking contact:', error);
                }
            }

            // Initial load of contacts when the page is loaded
            fetchContacts();

        </script>

